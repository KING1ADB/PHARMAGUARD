# PharmaGuard AI Configuration
PROJECT_NAME="PharmaGuard AI"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (SQLite default for local development, easily switchable to PostgreSQL)
DATABASE_URL="sqlite:///./pharmaguard.db"

# Agent Configuration
DEFAULT_PHARMACY_ID="PHARM-DLA-001"
DEFAULT_PHARMACY_NAME="Pharmacie du Centre - Douala"
DEFAULT_CITY="Douala"
DEFAULT_COUNTRY="Cameroon"

# Risk Thresholds
EXPIRY_CRITICAL_DAYS=30
EXPIRY_WARNING_DAYS=60
EXPIRY_NOTICE_DAYS=90
CRITICAL_STOCKOUT_DAYS=3
REORDER_LEAD_TIME_BUFFER_DAYS=2

# AI LLM Provider Configuration (Optional for mock / rule-based fallback mode)
OPENAI_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
MODEL_NAME="gpt-4o"
